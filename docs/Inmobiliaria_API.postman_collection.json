          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = {};",
                  "try { json = pm.response.json(); } catch (e) { return; }",
                  "var d = json.data || {};",
                  "if (d.access_token) { pm.collectionVariables.set('access_token', d.access_token); console.log('access_token guardado (2FA setup).'); }",
                  "if (d.refresh_token) { pm.collectionVariables.set('refresh_token', d.refresh_token); }"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{partial_token}}" } ] },
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"codigo\": \"123456\"\n}" },
            "url": { "raw": "{{base_url}}/api/auth/2fa/setup", "host": ["{{base_url}}"], "path": ["api", "auth", "2fa", "setup"] }
          }
        },
        {
          "name": "POST 2FA Verify (OTP en login)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// ── Genera el código TOTP (RFC 6238) desde {{totp_secret}} ──",
                  "// Requiere que la variable totp_secret (clave base32 del Authenticator) esté",
                  "// cargada en el environment. Si está vacía, deja el placeholder para OTP manual.",
                  "var secret = (pm.variables.get('totp_secret') || '').replace(/\\s/g, '').toUpperCase();",
                  "if (!secret) { console.warn('totp_secret vacío: ingrese el OTP manualmente en el body.'); return; }",
                  "",
                  "function base32ToHex(b32) {",
                  "    var alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ234567';",
                  "    var bits = '';",
                  "    for (var i = 0; i < b32.length; i++) {",
                  "        var val = alphabet.indexOf(b32.charAt(i));",
                  "        if (val < 0) continue;",
                  "        bits += val.toString(2).padStart(5, '0');",
                  "    }",
                  "    var hex = '';",
                  "    for (var j = 0; j + 8 <= bits.length; j += 8) {",
                  "        hex += parseInt(bits.substr(j, 8), 2).toString(16).padStart(2, '0');",
                  "    }",
                  "    return hex;",
                  "}",
                  "",
                  "var epoch = Math.floor(Date.now() / 1000);",
                  "var counter = Math.floor(epoch / 30);",
                  "var counterHex = counter.toString(16).padStart(16, '0');",
                  "",
                  "var keyHex = base32ToHex(secret);",
                  "var key = CryptoJS.enc.Hex.parse(keyHex);",
                  "var msg = CryptoJS.enc.Hex.parse(counterHex);",
                  "var hmac = CryptoJS.HmacSHA1(msg, key);",
                  "var hmacHex = hmac.toString(CryptoJS.enc.Hex);",
                  "",
                  "var offset = parseInt(hmacHex.substr(hmacHex.length - 1), 16);",
                  "var part = hmacHex.substr(offset * 2, 8);",
                  "var bin = (parseInt(part, 16) & 0x7fffffff);",
                  "var otp = (bin % 1000000).toString().padStart(6, '0');",
                  "",
                  "pm.variables.set('otp_code', otp);",
                  "console.log('OTP generado automáticamente:', otp);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = {};",
                  "try { json = pm.response.json(); } catch (e) { json = {}; }",
                  "var d = json.data || {};",
                  "if (d.access_token) { pm.collectionVariables.set('access_token', d.access_token); console.log('access_token guardado (2FA verify).'); }",
                  "if (d.refresh_token) { pm.collectionVariables.set('refresh_token', d.refresh_token); }",
                  "",
                  "pm.test('[2FA Verify] Autenticación completa con access_token', function () {",
                  "    pm.expect(json.success, json.message || '').to.eql(true);",
                  "    pm.expect(d).to.have.property('access_token');",
                  "    pm.expect(d.auth_state).to.eql('authenticated');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{partial_token}}" } ] },
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
