{
  "info": {
    "name": "Sistema Experto Inmobiliaria - API (OnRender)",
    "description": "Colección completa de endpoints del backend Flask del sistema experto de scoring crediticio. Apunta al servicio desplegado en OnRender. Autenticación: JWT Bearer (variable {{access_token}}). Flujo: 1) POST /api/auth/login, 2) completar 2FA (/2fa/verify o /2fa/setup) para obtener access_token, 3) usar el token en el resto de endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// ── Test de flujo correcto aplicado a TODOS los endpoints ──",
          "var nombre = (pm.info && pm.info.requestName) ? pm.info.requestName : 'request';",
          "",
          "// 1) Estado HTTP exitoso (2xx)",
          "pm.test('[' + nombre + '] Estado HTTP exitoso (2xx)', function () {",
          "    pm.expect(pm.response.code, 'código ' + pm.response.code).to.be.within(200, 299);",
          "});",
          "",
          "// 2) Tiempo de respuesta razonable (OnRender free puede arrancar lento)",
          "pm.test('[' + nombre + '] Tiempo de respuesta < 30s', function () {",
          "    pm.expect(pm.response.responseTime).to.be.below(30000);",
          "});",
          "",
          "// 3) Si la respuesta es JSON de la API, success no debe ser false",
          "var ct = pm.response.headers.get('Content-Type') || '';",
          "if (ct.indexOf('application/json') !== -1) {",
          "    var json;",
          "    try { json = pm.response.json(); } catch (e) { json = null; }",
          "    if (json && Object.prototype.hasOwnProperty.call(json, 'success')) {",
          "        pm.test('[' + nombre + '] Respuesta de API con success = true', function () {",
          "            pm.expect(json.success, 'mensaje: ' + (json.message || '')).to.not.eql(false);",
          "        });",
          "    }",
          "}"
        ]
      }
    }
  ],
