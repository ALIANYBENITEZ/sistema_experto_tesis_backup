      "item": [
        {
          "name": "POST Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [tecnico
                
                  "// Guarda automáticamente partial_token / access_token / refresh_token",
                  "var json = {};",
                  "try { json = pm.response.json(); } catch (e) { return; }",
                  "var d = json.data || {};",
                  "if (d.partial_token) {",
                  "  pm.collectionVariables.set('partial_token', d.partial_token);",
                  "  console.log('partial_token guardado. auth_state:', d.auth_state);",
                  "}",
                  "if (d.access_token) {",
                  "  pm.collectionVariables.set('access_token', d.access_token);",
                  "  console.log('access_token guardado (login directo).');",
                  "}",
                  "if (d.refresh_token) {",
                  "  pm.collectionVariables.set('refresh_token', d.refresh_token);",
                  "}",
                  "if (d.qr_code) { console.log('2FA setup requerido: escanee el QR devuelto.'); }",
                  "",
                  "pm.test('[Login] success = true', function () {",
                  "    pm.expect(json.success, json.message || '').to.eql(true);",
                  "});",
                  "pm.test('[Login] devuelve token y auth_state', function () {",
                  "    pm.expect(d).to.have.property('auth_state');",
                  "    pm.expect(d.partial_token || d.access_token, 'algún token').to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{login_email}}\",\n  \"password\": \"{{login_password}}\"\n}" },
            "url": { "raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api", "auth", "login"] }
          }
