      "item": [
        {
          "name": "POST Login (credenciales correctas)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = {}; try { json = pm.response.json(); } catch (e) {}",
                  "var d = json.data || {};",
                  "if (d.partial_token) pm.collectionVariables.set('partial_token', d.partial_token);",
                  "if (d.access_token) pm.collectionVariables.set('access_token', d.access_token);",
                  "if (d.refresh_token) pm.collectionVariables.set('refresh_token', d.refresh_token);",
                  "pm.test('[Login] Autentica y devuelve estado/token', function () {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.expect(d).to.have.property('auth_state');",
                  "    pm.expect(d.partial_token || d.access_token).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{login_email}}\",\n  \"password\": \"{{login_password}}\"\n}" },
            "url": { "raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "POST 2FA Verify (OTP automático)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Genera el código TOTP desde {{totp_secret}}.",
                  "// Si NO hay totp_secret, respeta el OTP que ponga el usuario en la variable otp_code.",
                  "var secret = (pm.variables.get('totp_secret') || '').replace(/\\s/g, '').toUpperCase();",
                  "if (!secret) {",
                  "    var manual = (pm.variables.get('otp_code') || '').trim();",
                  "    if (manual) { console.log('Usando OTP manual de la variable otp_code:', manual); }",
                  "    else { console.warn('No hay totp_secret ni otp_code. Cargue uno de los dos.'); }",
                  "    return;",
                  "}",
                  "function base32ToHex(b32) {",
                  "    var alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ234567';",
                  "    var bits = '';",
                  "    for (var i = 0; i < b32.length; i++) {",
                  "        var val = alphabet.indexOf(b32.charAt(i));",
                  "        if (val < 0) continue;",
                  "        bits += val.toString(2).padStart(5, '0');",
                  "    }",
                  "    var hex = '';",
                  "    for (var j = 0; j + 8 <= bits.length; j += 8) {",
                  "        hex += parseInt(bits.substr(j, 8), 2).toString(16).padStart(2, '0');",
                  "    }",
                  "    return hex;",
                  "}",
                  "function totpAt(counter, keyHex) {",
                  "    var counterHex = counter.toString(16).padStart(16, '0');",
                  "    var key = CryptoJS.enc.Hex.parse(keyHex);",
                  "    var msg = CryptoJS.enc.Hex.parse(counterHex);",
                  "    var hmacHex = CryptoJS.HmacSHA1(msg, key).toString(CryptoJS.enc.Hex);",
                  "    var offset = parseInt(hmacHex.substr(hmacHex.length - 1), 16);",
                  "    var bin = (parseInt(hmacHex.substr(offset * 2, 8), 16) & 0x7fffffff);",
                  "    return (bin % 1000000).toString().padStart(6, '0');",
                  "}",
                  "var keyHex = base32ToHex(secret);",
                  "var counter = Math.floor(Math.floor(Date.now() / 1000) / 30);",
                  "var otp = totpAt(counter, keyHex);",
                  "// Escribe el código en TODOS los alcances para que {{otp_code}} se reemplace sí o sí.",
                  "pm.variables.set('otp_code', otp);",
                  "pm.collectionVariables.set('otp_code', otp);",
                  "if (pm.environment && pm.environment.name) { pm.environment.set('otp_code', otp); }",
                  "console.log('OTP generado:', otp, '| prev:', totpAt(counter-1, keyHex), '| next:', totpAt(counter+1, keyHex));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = {}; try { json = pm.response.json(); } catch (e) {}",
                  "var d = json.data || {};",
                  "if (d.access_token) pm.collectionVariables.set('access_token', d.access_token);",
                  "if (d.refresh_token) pm.collectionVariables.set('refresh_token', d.refresh_token);",
                  "if (pm.response.code !== 200) {",
                  "    console.error('2FA Verify falló (' + pm.response.code + '). Motivo del servidor:', json.message || pm.response.text());",
                  "    console.error('OTP enviado:', pm.variables.get('otp_code'), '— si no coincide con tu app, revisá el reloj de tu PC o el totp_secret.');",
                  "}",
                  "pm.test('[2FA] Autenticación completa con access_token', function () {",
                  "    pm.expect(pm.response.code, json.message || '').to.eql(200);",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.expect(d).to.have.property('access_token');",
                  "    pm.expect(d.auth_state).to.eql('authenticated');",
                  "});"
                ]
              }
            }
          ],
