<style>
  @page { size: A4; margin: 2cm; }
  body { font-family: "Times New Roman", serif; font-size: 12pt; color: #000000; }
  h1 { font-size: 16pt; text-align: center; color: #000000; font-weight: bold; }
  .sub { text-align: center; font-size: 11pt; color: #000000; margin-bottom: 18pt; }
  h2 { font-size: 13pt; color: #000000; font-weight: bold; margin: 18pt 0 6pt; }
  table { width: 100%; border-collapse: collapse; margin-bottom: 22pt; }
  td, th { border: 1px solid #000000; padding: 5pt 8pt; vertical-align: top; color: #000000; font-size: 11pt; }
  td.lbl { width: 150px; font-weight: bold; }
  .paso b { font-weight: bold; }
  p { margin: 0 0 4pt; }
</style>
