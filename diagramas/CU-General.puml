@startuml
left to right direction

actor Propietario as PROP
actor Administrador as ADMIN
actor Operador as OPER

rectangle "Sistema de Evaluacion de Riesgo Crediticio" {
    usecase "CU-01 Iniciar sesion (2FA)" as CU01
    usecase "CU-02 Gestionar usuarios" as CU02
    usecase "CU-03 Gestionar clientes" as CU03
    usecase "CU-04 Configurar reglas y criterios" as CU04
    usecase "CU-05 Evaluar riesgo de cliente" as CU05
    usecase "CU-06 Generar reportes" as CU06
    usecase "CU-07 Consultar auditoria" as CU07
    usecase "CU-08 Gestionar empresas" as CU08
    usecase "Verificar lista de sanciones" as LN
    usecase "Solicitar codigo 2FA (OTP)" as OTP
}

OPER --> CU03
OPER --> CU05
OPER --> CU06

ADMIN --> CU02
ADMIN --> CU03
ADMIN --> CU04
ADMIN --> CU06
ADMIN --> CU07

PROP --> CU08
PROP --> CU07

CU02 ..> CU01 : <<include>>
CU03 ..> CU01 : <<include>>
CU04 ..> CU01 : <<include>>
CU05 ..> CU01 : <<include>>
CU06 ..> CU01 : <<include>>
CU07 ..> CU01 : <<include>>
CU08 ..> CU01 : <<include>>

CU05 ..> LN : <<include>>

OTP ..> CU01 : <<extend>>

@enduml
