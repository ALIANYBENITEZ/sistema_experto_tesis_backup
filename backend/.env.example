# ============================================================
#  Plantilla de variables de entorno del backend
#  Copie este archivo como ".env" y complete los valores.
#  NUNCA suba el .env real al repositorio.
# ============================================================

FLASK_ENV=development

# ── Claves secretas (OBLIGATORIAS en producción) ──
# Genere valores aleatorios y largos (mínimo 32 caracteres). Ejemplos para generarlos:
#   Python:      python -c "import secrets; print(secrets.token_urlsafe(48))"
#   PowerShell:  [Convert]::ToBase64String((1..48 | % {Get-Random -Max 256}))
SECRET_KEY=genere_una_clave_aleatoria_de_al_menos_32_caracteres
JWT_SECRET_KEY=genere_otra_clave_aleatoria_distinta_de_al_menos_32_caracteres

# ── PostgreSQL ──
# Opción A) URL completa. Es la forma que usa Render (ahí se enlaza desde la BD).
#   Formato: postgresql+psycopg://USUARIO:CONTRASENA@HOST:PUERTO/BASE
#   Render entrega "postgres://..."; la app la normaliza automáticamente.
DATABASE_URL=postgresql+psycopg://inmobiliaria:CAMBIAR@localhost:5432/inmobiliaria_db

# Opción B) Por partes (se usa solo si DATABASE_URL está vacía).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inmobiliaria_db
DB_USER=inmobiliaria
DB_PASSWORD=CAMBIAR

# ── URLs de la aplicación ──
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# ── Pasarela de pagos Pagopar (Paraguay) ──
# Obtenga public/private key en el panel de Pagopar: "Integrar con mi sitio web".
# Si se dejan vacías, el sistema usa el flujo de pago TEST (no cobra realmente).
PAGOPAR_PUBLIC_KEY=
PAGOPAR_PRIVATE_KEY=
PAGOPAR_BASE_URL=https://api.pagopar.com/api
# Página del frontend a la que Pagopar redirige tras el pago
PAGOPAR_URL_RETORNO=http://localhost:3000/facturacion
# URL PÚBLICA del backend que Pagopar invoca para notificar el pago (webhook).
# En producción debe ser accesible desde internet (no localhost).
PAGOPAR_URL_NOTIFICACION=http://localhost:5000/api/facturacion/pagopar/webhook
